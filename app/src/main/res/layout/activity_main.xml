<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="🛡️ AEGIS — 地震・津波・気象"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/tabBriefing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ブリーフィング" />

        <Button
            android:id="@+id/tabQuakes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="地震情報" />

        <Button
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="設定" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻ 更新" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/modeDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="直接取得（推奨）"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/modeServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AEGISサーバーから取得"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.1.10:8765"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A94A6" />

        <Button
            android:id="@+id/testConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="接続テスト（サーバーURL）" />

        <Button
            android:id="@+id/saveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="設定を保存" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="📍 監視地点の追加（任意地点）"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="都道府県コード例: 群馬県 100000 / 埼玉県 110000 / 東京都 130000（気象庁の都道府県コード）。地域名は気象庁の一次細分区域名（例: 南部）。緯度経度は地図アプリ等で調べられます。"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/locName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="地点名（例: 実家）"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A94A6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/locLat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="緯度（例: 36.32）"
                android:inputType="numberDecimal|numberSigned"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A94A6" />

            <EditText
                android:id="@+id/locLon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="経度（例: 139.00）"
                android:inputType="numberDecimal|numberSigned"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A94A6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/locPref"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="都道府県コード"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A94A6" />

            <EditText
                android:id="@+id/locArea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="地域名（例: 南部）"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A94A6" />
        </LinearLayout>

        <Button
            android:id="@+id/addLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="地点を追加" />

        <LinearLayout
            android:id="@+id/customLocList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:textColor="#8A94A6"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>
</LinearLayout>
