<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1220">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="🛡️ AEGIS — 地震・津波・気象"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/tabBriefing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="ブリーフィング"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tabQuakes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="地震"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tabRadar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="レーダー"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tabNews"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="ニュース"
            android:textSize="11sp" />

        <Button
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="設定"
            android:textSize="11sp" />

        <Button
            android:id="@+id/refreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="↻"
            android:textSize="13sp" />
    </LinearLayout>


    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:textColor="#8A94A6"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/modeDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="直接取得（推奨）"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/modeServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AEGISサーバーから取得"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <EditText
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="http://192.168.1.10:8765"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A94A6" />

        <Button
            android:id="@+id/testConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="接続テスト（サーバーURL）" />

        <Button
            android:id="@+id/saveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="設定を保存" />

        <Button
            android:id="@+id/diagTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🩺 接続テスト（自己診断）" />

        <Button
            android:id="@+id/demoTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧪 テスト表示（デモ）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="接続テストは各データソースへの到達を確認します。テスト表示はサンプルの警報・緊急地震速報（カウントダウン付き）を表示するデモで、実際のデータに切り替わると自動で終了します。"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="🔔 バックグラウンド同期と通知"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bgSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="バックグラウンド同期: -"
            android:textColor="#D8DEE9"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/bgSyncSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="バックグラウンド同期（アプリを閉じていても新着を通知）"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="同期間隔"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/syncIntervalGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/interval15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15分"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/interval30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30分"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/interval60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60分"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <TextView
            android:id="@+id/notifyPermStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="通知の許可: -"
            android:textColor="#D8DEE9"
            android:textSize="12sp" />

        <Button
            android:id="@+id/notifyPermButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通知の許可をリクエスト" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="地震の通知しきい値"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/quakeThresholdGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/thrScale10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="震度1"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/thrScale20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="震度2"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/thrScale30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="震度3"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/thrScale40"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="震度4"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/thrScale45"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="震度5弱"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="警報の通知範囲"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/warnModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/warnAlertsOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="特別警報・警報のみ"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/warnIncludeAdvisory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="注意報も含む"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <Switch
            android:id="@+id/briefingNotifySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="朝夕ブリーフィング通知（7:00 / 21:00、任意）"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/notifyTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 通知テスト" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="緊急地震速報と津波は常に通知します。地震は上のしきい値以上、警報は発表・変更時に通知します。通知済みの情報は再通知しません。発生から1時間以上たった情報は通知しません。"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:text="📍 監視地点の追加（任意地点）"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="都道府県コード例: 群馬県 100000 / 埼玉県 110000 / 東京都 130000（気象庁の都道府県コード）。地域名は気象庁の一次細分区域名（例: 南部）。緯度経度は地図アプリ等で調べられます。"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/locName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="地点名（例: 実家）"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A94A6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/locLat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="緯度（例: 36.32）"
                android:inputType="numberDecimal|numberSigned"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A94A6" />

            <EditText
                android:id="@+id/locLon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="経度（例: 139.00）"
                android:inputType="numberDecimal|numberSigned"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A94A6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/locPref"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="都道府県コード"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A94A6" />

            <EditText
                android:id="@+id/locArea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="地域名（例: 南部）"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A94A6" />
        </LinearLayout>

        <Button
            android:id="@+id/addLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="地点を追加" />

        <Button
            android:id="@+id/gpsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 現在地（GPS）を取得して地点登録" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GPSで取得した位置から都道府県を推定し、地域区分を選んで「現在地」として登録します。"
            android:textColor="#8A94A6"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/customLocList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
